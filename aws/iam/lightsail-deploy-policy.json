{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageLightsail",
      "Effect": "Allow",
      "Action": "lightsail:*",
      "Resource": "*"
    },
    {
      "Sid": "ReadBasicMonitoring",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateLightsailServiceRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/lightsail.amazonaws.com/*",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": "lightsail.amazonaws.com"
        }
      }
    }
  ]
}

