#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this script as root." >&2
  exit 1
fi

database_name=xau_monitor
database_role=xau_monitor
environment_dir=/etc/xau-monitor
environment_file="${environment_dir}/database.env"
migration_dir=/opt/xau-monitor/db/migrations

command -v psql >/dev/null
command -v openssl >/dev/null
test -d "${migration_dir}"

install -d -o root -g root -m 0700 "${environment_dir}"

if ! runuser -u postgres -- psql \
  --quiet \
  --tuples-only \
  --no-align \
  --command="SELECT 1 FROM pg_roles WHERE rolname = '${database_role}'" |
  grep -qx 1; then
  runuser -u postgres -- psql \
    --set=ON_ERROR_STOP=1 \
    --command="CREATE ROLE ${database_role} LOGIN"
fi

runuser -u postgres -- psql \
  --set=ON_ERROR_STOP=1 \
  --command="ALTER ROLE ${database_role} NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION"

if [[ ! -f "${environment_file}" ]]; then
  database_password="$(openssl rand -hex 32)"
  printf "ALTER ROLE %s PASSWORD '%s';\n" \
    "${database_role}" \
    "${database_password}" |
    runuser -u postgres -- psql --set=ON_ERROR_STOP=1

  temporary_environment="$(mktemp)"
  trap 'rm -f "${temporary_environment:-}"' EXIT
  umask 077
  printf 'DATABASE_URL=postgresql://%s:%s@127.0.0.1:5432/%s\n' \
    "${database_role}" \
    "${database_password}" \
    "${database_name}" >"${temporary_environment}"
  install -o root -g root -m 0600 \
    "${temporary_environment}" \
    "${environment_file}"
fi

if ! runuser -u postgres -- psql \
  --quiet \
  --tuples-only \
  --no-align \
  --command="SELECT 1 FROM pg_database WHERE datname = '${database_name}'" |
  grep -qx 1; then
  runuser -u postgres -- createdb \
    --owner="${database_role}" \
    --encoding=UTF8 \
    "${database_name}"
fi

runuser -u postgres -- psql \
  --set=ON_ERROR_STOP=1 \
  --command="REVOKE ALL ON DATABASE ${database_name} FROM PUBLIC"
runuser -u postgres -- psql \
  --set=ON_ERROR_STOP=1 \
  --command="GRANT CONNECT, TEMPORARY ON DATABASE ${database_name} TO ${database_role}"
runuser -u postgres -- psql \
  --set=ON_ERROR_STOP=1 \
  --command="ALTER SYSTEM SET listen_addresses TO '127.0.0.1'"
runuser -u postgres -- psql \
  --set=ON_ERROR_STOP=1 \
  --command="ALTER SYSTEM SET password_encryption TO 'scram-sha-256'"

systemctl restart postgresql

shopt -s nullglob
migration_files=("${migration_dir}"/*.sql)
if [[ "${#migration_files[@]}" -eq 0 ]]; then
  echo "No database migrations found." >&2
  exit 1
fi
for migration_file in "${migration_files[@]}"; do
  migration_name="$(basename "${migration_file}")"
  if [[ ! "${migration_name}" =~ ^([0-9]{3})_ ]]; then
    echo "Invalid migration filename: ${migration_name}" >&2
    exit 1
  fi
  migration_version="$((10#${BASH_REMATCH[1]}))"
  migration_table_exists="$(
    runuser -u postgres -- psql \
      --quiet \
      --tuples-only \
      --no-align \
      --dbname="${database_name}" \
      --command="SELECT to_regclass('app.schema_migrations') IS NOT NULL"
  )"
  if [[ "${migration_table_exists}" == "t" ]] &&
    runuser -u postgres -- psql \
      --quiet \
      --tuples-only \
      --no-align \
      --dbname="${database_name}" \
      --command="SELECT 1 FROM app.schema_migrations WHERE version = ${migration_version}" |
      grep -qx 1; then
    printf 'Skipping applied migration %s\n' "${migration_name}"
    continue
  fi
  runuser -u postgres -- psql \
    --set=ON_ERROR_STOP=1 \
    --dbname="${database_name}" \
    --file="${migration_file}"
done

database_url="$(
  sed -n 's/^DATABASE_URL=//p' "${environment_file}"
)"
test -n "${database_url}"

runuser -u ubuntu -- env DATABASE_URL="${database_url}" \
  psql "${database_url}" \
  --set=ON_ERROR_STOP=1 \
  --quiet \
  --command="SELECT version FROM app.schema_migrations ORDER BY version DESC LIMIT 1" \
  >/dev/null

unset database_url database_password
