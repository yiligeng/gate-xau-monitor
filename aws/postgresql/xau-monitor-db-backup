#!/usr/bin/env bash
set -euo pipefail

backup_dir=/var/backups/xau-monitor-postgresql
database_name=xau_monitor
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_path="${backup_dir}/${database_name}-${timestamp}.dump"

install -d -o postgres -g postgres -m 0700 "${backup_dir}"
runuser -u postgres -- pg_dump \
  --format=custom \
  --compress=6 \
  --file="${backup_path}" \
  "${database_name}"
runuser -u postgres -- pg_restore --list "${backup_path}" >/dev/null
find "${backup_dir}" \
  -type f \
  -name "${database_name}-*.dump" \
  -mtime +6 \
  -delete
