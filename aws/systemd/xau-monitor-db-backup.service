[Unit]
Description=Back up the xau-monitor PostgreSQL database
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xau-monitor-db-backup
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/xau-monitor-postgresql
