#!/usr/bin/env bash
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive

if [[ "${EUID}" -ne 0 ]]; then
  echo "update-xau-tzdata must run as root." >&2
  exit 1
fi

apt-get update -qq
apt-get install -y --only-upgrade tzdata

python3 - <<'PY'
from datetime import datetime
from zoneinfo import ZoneInfo

for name in ("America/New_York", "Europe/London", "Asia/Shanghai"):
    zone = ZoneInfo(name)
    datetime.now(zone).utcoffset()
print("Time zone database validation passed.")
PY
